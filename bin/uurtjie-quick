#!/usr/bin/env bash
# Quick-add popup for uurtjie. Bound to a Hyprland key (see hypr/uurtjie-bindings.conf).
#   uurtjie-quick          -> opens a small floating terminal running the prompt
#   uurtjie-quick --prompt -> the prompt itself (readline history, live preview, notify on save)
set -uo pipefail
UURTJIE="$HOME/.local/bin/uurtjie"
HIST="$HOME/.local/share/uurtjie/quick_history"

if [[ "${1:-}" != "--prompt" ]]; then
  exec xdg-terminal-exec --app-id=uurtjie.quick --title="Uurtjie quick add" -e "$0" --prompt
fi

umask 077
mkdir -p "$(dirname "$HIST")"; touch "$HIST"; chmod 600 "$HIST"
HISTFILE="$HIST"; history -r

printf '\e[1mUurtjie — quick add\e[0m   today: %s\n' "$("$UURTJIE" status --json | python3 -c 'import json,sys;print(json.load(sys.stdin)["today"]["hm"])' 2>/dev/null)"
printf '\e[2mprojects: %s\e[0m\n' "$("$UURTJIE" projects | awk '/^[* ] /{print $2}' | paste -sd' ')"
printf '\e[2me.g.  acme 1h30 call with PM · 09:00-10:30 standup · y 2h code review · fri 45m docs nb\e[0m\n\n'

while true; do
  read -e -r -p "› " line || exit 0
  [[ -z "$line" ]] && exit 0
  if preview=$("$UURTJIE" quick --dry-run -- "$line" 2>&1); then
    history -s "$line"; history -w
    out=$("$UURTJIE" quick -- "$line" 2>&1)
    notify-send -a uurtjie -i appointment-new "Uurtjie" "$out" 2>/dev/null
    printf '\e[32m✓ %s\e[0m\n' "$out"
    sleep 0.8; exit 0
  else
    printf '\e[31m%s\e[0m\n' "$preview"
  fi
done
