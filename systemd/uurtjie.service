[Unit]
Description=uurtjie — client time tracker (Hyprland + Herdr activity)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
UMask=0077
ExecStart=%h/.local/bin/uurtjie daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
